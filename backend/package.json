{
  "name": "backend",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "env-encrypt": "dotenvx encrypt",
    "dev": "dotenvx run -- npx nodemon --watch . --ext ts,js --exec tsx app.ts",
    "prod": "dotenvx run -- npx tsx app.ts",
    "drizzle-generate": "dotenvx run -- npx drizzle-kit generate --config=./src/database/drizzle/drizzle.config.ts",
    "drizzle-pull": "dotenvx run -- npx drizzle-kit pull --config=./src/database/drizzle/drizzle.config.ts",
    "drizzle-push": "dotenvx run -- npx drizzle-kit push --config=./src/database/drizzle/drizzle.config.ts"
  },
  "keywords": [],
  "author": "wianwiryawan@gmail.com",
  "license": "ISC",
  "description": "Laundry app with auth, CRUD functionality, and can generate report based on data.",
  "dependencies": {
    "@dotenvx/dotenvx": "^0.10.6",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.4",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
